---
import { marked } from "marked";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPostBySlug, listPosts } from "../../lib/db";
import { coverFor } from "../../lib/covers";
import { breadcrumbSchema, faqPageSchema } from "../../lib/schema";
import {
  extractJumpLinks,
  withHeadingAnchors,
  wrapTables,
  stripLeadingJumpNavHtml,
} from "../../lib/blog-toc";

/** Pull FAQ Q&As from a trailing ## FAQ section of markdown (### question + paragraphs). */
function extractFaqs(markdown: string): Array<{ question: string; answer: string }> {
  const faqMatch = markdown.match(/^##\s+FAQ[^\n]*\n([\s\S]*)$/im);
  if (!faqMatch) return [];
  const body = faqMatch[1];
  const blocks = body.split(/^###\s+/m).slice(1);
  return blocks
    .map((block) => {
      const nl = block.indexOf("\n");
      const question = (nl === -1 ? block : block.slice(0, nl)).trim();
      const answer = (nl === -1 ? "" : block.slice(nl + 1))
        .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
        .replace(/[*_`]/g, "")
        .replace(/\n+/g, " ")
        .trim();
      return { question, answer };
    })
    .filter((f) => f.question && f.answer);
}

const post = await getPostBySlug(Astro.params.slug!);
if (!post || post.draft) {
  return new Response("Not found", { status: 404 });
}

const { title, description, content: rawContent, author, tags, cover_image, pub_date, updated_date, slug } = post;

// Prefer author jump-link labels over raw H2 copy in the "In this article" nav.
// Always strip that list from the body so it is not shown again under the auto-nav.
const { content, links: jumpLinks } = extractJumpLinks(rawContent);
const parsedHtml = stripLeadingJumpNavHtml(marked.parse(content) as string);
const { html: anchoredHtml, toc } = withHeadingAnchors(parsedHtml, jumpLinks);
const html = wrapTables(anchoredHtml);
const wordCount = content.replace(/[#*_`>\[\]()]/g, " ").trim().split(/\s+/).filter(Boolean).length;
const faqs = extractFaqs(content);
const coverAlts: Record<string, string> = {
  "website-redesign-vs-rebuild-dubai":
    "Team reviewing a website redesign plan at Vedha Technologies in Dubai.",
  "web-mobile-app-maintenance-dubai":
    "Vedha engineer maintaining a website and mobile app dashboard in Dubai.",
  "web-apps-vs-native-apps-dubai":
    "Web app and native app shown side by side, split by a neon divider, illustrating the build decision for Dubai businesses.",
  "best-cms-platforms-uae":
    "A row of website screens compared side by side, illustrating the best CMS platforms for UAE businesses to choose from.",
  "ai-readiness-checklist-dubai":
    "A printed AI-readiness checklist on a desk beside a laptop, being reviewed before a Dubai business invests in AI.",
  "mvp-vs-full-product-dubai":
    "Two phones side by side showing the same app as a lean MVP and as a full product, illustrating the build choice for Dubai startups.",
  "custom-ai-assistants-internal-teams-uae":
    "Operations, finance and sales colleagues using the same custom AI assistant across their devices in a UAE office.",
  "build-vs-buy-ai-solutions":
    "A sealed software box and a stack of building blocks either side of a laptop reading \"Build vs Buy\", representing the AI build-versus-buy choice.",
  "loyalty-app-development-uae":
    "A customer tapping to redeem loyalty rewards on a phone app at a UAE café counter.",
  "corporate-website-design-dubai":
    "A corporate website wireframe displayed on a meeting-room screen and laptop, illustrating the design process for a growing Dubai brand.",
  "membership-website-design-ux-billing-retention":
    "A person viewing a membership portal on their phone, seen over the shoulder, illustrating UX and billing design for membership websites.",
  "business-automation-near-me-dubai":
    "Several interlocking gears with one neon gear standing out, representing choosing the right business process to automate first.",
  "website-migration-dubai":
    "Team reviewing an SEO-safe website migration plan on a laptop during a Dubai platform migration project.",
  "ai-customer-support-dubai-uae":
    "A smartphone showing a customer-support chat surrounded by floating chat bubbles, representing 24/7 AI customer support.",
  "landing-page-patterns-uae-real-estate-hospitality-clinics-b2b":
    "Four UAE landing page concepts for real estate, hospitality, clinics and B2B campaigns displayed across modern digital screens.",
  "responsive-website-design-uae-mobile-first-seo":
    "A smartphone showing a mobile website layout with a small upward-trend accent, representing mobile-first responsive design and its effect on SEO.",
  "best-ecommerce-platform-uae-shopify-woocommerce-magento-custom":
    "A wordless online store on a phone surrounded by floating product cards, a cart and parcels, representing best ecommerce platforms in the UAE.",
  "corporate-website-cost-dubai-pricing-timelines-hidden-fees":
    "Printed website wireframes spread on a desk beside a ruler and pen, illustrating the scoping and cost of a corporate website in Dubai.",
  "learning-management-system-dubai-lms-training-providers":
    "A tablet showing a wordless learning platform dashboard with course tiles, a progress ring and a certificate, surrounded by floating course cards, representing an LMS for Dubai training providers.",
  "what-is-digital-transformation-consulting-uae-2026-guide":
    "Consultant mapping a digital process flowchart on glass in a Dubai office overlooking the skyline, representing digital transformation consulting for UAE businesses.",
};
const coverAlt = coverAlts[slug] ?? `${title} article cover`;

const allPosts = await listPosts();
const otherPosts = allPosts.filter((p) => p.slug !== slug);

const cover = coverFor(slug, cover_image);
const coverAbsolute = new URL(cover, Astro.site).toString();

const thumbOf = (s: string, img: string | null) => coverFor(s, img);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

const formatShort = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

const postSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  keywords: tags.join(", "),
  articleSection: tags[0] ?? "Insights",
  wordCount,
  datePublished: pub_date.toISOString(),
  dateModified: (updated_date ?? pub_date).toISOString(),
  image: coverAbsolute,
  author: { "@type": "Organization", name: author, url: Astro.site?.toString() },
  publisher: {
    "@type": "Organization",
    name: "Vedha Technologies",
    url: Astro.site?.toString(),
    logo: { "@type": "ImageObject", url: new URL("/images/vedha-logo.png", Astro.site).toString() },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": pageUrl,
  },
  inLanguage: "en-AE",
};

const crumbs = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: title, path: `/blog/${slug}/` },
]);

const faqSchema = faqs.length > 0 ? faqPageSchema(faqs) : null;

// Prefer a clean SEO title; append brand only when the post title is short/generic.
const documentTitle =
  /vedha|uae guide|\bdubai\b/i.test(title) || title.length >= 55
    ? title
    : `${title} — VEDHA Blog`;
---
<BaseLayout
  title={documentTitle}
  description={description}
  ogType="article"
  publishedTime={pub_date}
  modifiedTime={updated_date ?? pub_date}
  ogImage={cover}
>
  <div class="post-layout">
    <aside class="post-aside" data-reveal>
      <p class="post-aside__kicker">All posts</p>
      <nav class="post-aside__nav" aria-label="Other blog posts">
        <ul>
          {otherPosts.map((p) => (
            <li>
              <a href={`/blog/${p.slug}/`} class="post-aside__link">
                <img
                  src={thumbOf(p.slug, p.cover_image)}
                  alt={`${p.title} article cover`}
                  width="96"
                  height="72"
                  loading="lazy"
                />
                <span>
                  <time datetime={p.pub_date.toISOString().split("T")[0]}>{formatShort(p.pub_date)}</time>
                  <strong>{p.title}</strong>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a class="post-aside__all" href="/blog/">View blog index →</a>
    </aside>

    <article class="post">
      <header class="post__header">
        <p class="kicker">
          (Blog)
          {tags.length > 0 && <>&ensp;[{tags.join(" · ")}]</>}
        </p>
        <h1 class="post__title">{title}</h1>
        <p class="post__meta">
          <time datetime={pub_date.toISOString().split("T")[0]}>{formatDate(pub_date)}</time>
          <span aria-hidden="true">·</span>
          <span>{author}</span>
        </p>
      </header>

      <figure class="post__cover">
        <img src={cover} alt={coverAlt} width="1600" height="900" loading="eager" />
      </figure>

      {toc.length > 1 && (
        <nav class="post__toc" aria-label="On this page">
          <p class="post__toc-label">In this article</p>
          <ol class="post__toc-list">
            {toc.map((item) => (
              <li>
                <a href={`#${item.id}`}>{item.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="post__prose" set:html={html} />

      <footer class="post__footer">
        <a class="btn btn--ghost" href="/blog/"><span>← All posts</span></a>
        <a class="btn btn--dark" href="/#book" data-book-consultation><span>Book a free consultation</span></a>
      </footer>
    </article>
  </div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(postSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  {faqSchema && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  )}
</BaseLayout>

<style>
  .post-layout {
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: calc(4.5rem + clamp(2rem, 6vh, 4rem)) var(--gutter) clamp(3rem, 8vh, 6rem);
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  .post-aside {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .post-aside__kicker {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .post-aside__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
    border-top: 1px solid var(--line);
  }
  .post-aside__link {
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
    transition: opacity 0.25s, transform 0.3s var(--ease-out);
  }
  .post-aside__link:hover {
    opacity: 0.72;
    transform: translateX(0.2rem);
  }
  .post-aside__link img {
    width: 4.25rem;
    height: 3.15rem;
    object-fit: cover;
    border-radius: 0.45rem;
    background: var(--dark);
  }
  .post-aside__link span {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }
  .post-aside__link time {
    font-size: 0.68rem;
    color: var(--ink-soft);
    letter-spacing: 0.04em;
  }
  .post-aside__link strong {
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-aside__all {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.25s;
  }
  .post-aside__all:hover { color: var(--ink); }

  .post {
    min-width: 0;
    max-width: 44rem;
    display: grid;
    gap: clamp(1.6rem, 3vh, 2.4rem);
  }
  .post__header { display: grid; gap: 0.9rem; }
  .post__title {
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
    max-width: 18ch;
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .post__cover {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 16 / 9;
    background: var(--dark);
  }
  .post__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .post__toc {
    display: grid;
    gap: 0.75rem;
    padding: 1rem 0 0.25rem;
    border-bottom: 1px solid var(--line);
  }
  .post__toc-label {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .post__toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .post__toc-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
  }
  .post__toc-list li::before {
    content: "";
    width: 0.28rem;
    height: 0.28rem;
    margin-top: 0.55em;
    border-radius: 50%;
    background: rgba(17, 17, 17, 0.42);
    flex-shrink: 0;
  }
  .post__toc-list a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
    font-size: 0.98rem;
    line-height: 1.4;
    transition: color 0.2s, text-decoration-color 0.2s;
  }
  .post__toc-list a:hover,
  .post__toc-list a:focus-visible {
    color: #1765d5;
    text-decoration-color: rgba(23, 101, 213, 0.55);
  }
  .post__toc-list a:active {
    color: #0f4da8;
  }
  .post__prose {
    display: grid;
    gap: 1.15rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(17, 17, 17, 0.88);
  }
  .post__prose :global(h2) {
    margin-top: 1.1rem;
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--ink);
    scroll-margin-top: 5.5rem;
  }
  .post__prose :global(p) { margin: 0; }
  .post__prose :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .post__prose :global(blockquote) {
    margin: 0.4rem 0;
    padding: 0.85rem 0 0.85rem 1.1rem;
    border-left: 2px solid rgba(17, 17, 17, 0.18);
    color: var(--ink-soft);
    font-style: italic;
  }
  .post__prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius) * 0.85);
    margin: 0.4rem 0;
  }
  .post__prose :global(ul),
  .post__prose :global(ol) {
    padding-left: 1.35rem;
    display: grid;
    gap: 0.4rem;
  }
  .post__prose :global(ul) {
    list-style: disc;
  }
  .post__prose :global(ol) {
    list-style: decimal;
  }
  .post__prose :global(li)::marker {
    color: rgba(17, 17, 17, 0.55);
  }
  .post__prose :global(.post__table-wrap) {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    margin: 0.15rem 0;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) * 0.7);
    background:
      linear-gradient(to right, #fff 85%, rgba(255, 255, 255, 0)) left center / 1.25rem 100% no-repeat,
      linear-gradient(to left, #fff 85%, rgba(255, 255, 255, 0)) right center / 1.25rem 100% no-repeat,
      linear-gradient(to right, rgba(17, 17, 17, 0.08), transparent) left center / 0.7rem 100% no-repeat local,
      linear-gradient(to left, rgba(17, 17, 17, 0.08), transparent) right center / 0.7rem 100% no-repeat local,
      #fff;
    background-attachment: local, local, scroll, scroll;
  }
  .post__prose :global(.post__table-wrap:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  .post__prose :global(table) {
    width: max-content;
    min-width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    line-height: 1.45;
    table-layout: auto;
  }
  .post__prose :global(th),
  .post__prose :global(td) {
    border: 1px solid var(--line);
    padding: 0.7rem 0.85rem;
    text-align: left;
    vertical-align: top;
    white-space: normal;
    word-break: normal;
    overflow-wrap: anywhere;
    min-width: 7.5rem;
    max-width: 14rem;
  }
  .post__prose :global(th:first-child),
  .post__prose :global(td:first-child) {
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 7rem;
    max-width: 10rem;
    background: #fff;
    box-shadow: 1px 0 0 var(--line);
  }
  .post__prose :global(th) {
    background: rgba(17, 17, 17, 0.04);
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }
  .post__prose :global(th:first-child) {
    z-index: 2;
    background: #f3f3f3;
    white-space: normal;
  }
  @media (min-width: 48rem) {
    .post__prose :global(th),
    .post__prose :global(td) {
      font-size: 0.92rem;
      min-width: 8.5rem;
      max-width: 16rem;
    }
  }
  .post__prose :global(h3) {
    margin-top: 0.65rem;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
    color: var(--ink);
  }
  .post__footer {
    margin-top: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  @media (min-width: 64rem) {
    .post-layout {
      grid-template-columns: minmax(15rem, 17.5rem) minmax(0, 44rem);
      justify-content: center;
    }
    .post-aside {
      position: sticky;
      top: 6rem;
    }
  }

  @media (max-width: 63.99rem) {
    .post-aside {
      order: 2;
      padding-top: 0.5rem;
      border-top: 1px solid var(--line);
    }
    .post { order: 1; max-width: none; }
    .post__title { max-width: none; }
  }
</style>
