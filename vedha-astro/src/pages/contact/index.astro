---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { breadcrumbSchema } from "../../lib/schema";

const pagePath = "/contact/";
const schema = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Contact", path: pagePath },
]);
---
<BaseLayout
  title="Contact — VEDHA"
  description="Contact Vedha Technologies in Dubai — send an enquiry, subscribe to updates, or book a free consultation."
  ogImage="/images/photo-lake-jetty.jpg"
  preloadHeroImage="/images/photo-lake-jetty.jpg"
>
  <article class="contact-page">
    <figure class="scene-banner" data-scene-banner>
      <img
        src="/images/photo-lake-jetty.jpg"
        alt=""
        width="1920"
        height="1279"
        loading="eager"
        decoding="async"
        aria-hidden="true"
      />
      <h1 class="scene-banner__title">Contact</h1>
      <figcaption class="scene-banner__meta">
        <span>Dubai</span>
        <span>Let’s talk</span>
      </figcaption>
    </figure>

    <div class="contact-page__layout">
      <div class="contact-page__main">
        <header class="contact-page__intro">
          <p class="kicker">(Contact us)</p>
          <h2>Let’s talk.</h2>
          <p>
            Send an enquiry and we’ll get back to you — or book a free consultation
            on our calendar.
          </p>
          <button type="button" class="btn btn--dark" data-book-consultation>
            <span>Book free consultation</span>
          </button>
        </header>

        <form class="contact__form" id="enquiry" method="post" data-mail-form="enquiry">
          <p class="kicker">(Send us an enquiry)</p>
          <label>Name
            <input type="text" name="name" placeholder="Your name" required autocomplete="name" />
          </label>
          <label>Email
            <input type="email" name="email" placeholder="Email" required autocomplete="email" />
          </label>
          <label>Service type
            <select name="service" required>
              <option value="" disabled selected>Select a service</option>
              <option value="web-development">Web Development &amp; CMS</option>
              <option value="ui-ux">UI/UX Design</option>
              <option value="ecommerce">E-Commerce Development</option>
              <option value="ai">AI Development</option>
              <option value="web-apps">Web Applications &amp; Integrations</option>
              <option value="brand-support">Brand, Support &amp; Growth</option>
              <option value="other">Other</option>
            </select>
          </label>
          <label>Description
            <textarea name="description" rows="5" placeholder="Tell us about your project" required></textarea>
          </label>
          <button class="btn btn--dark btn--wide" type="submit"><span>Send enquiry</span></button>
          <p class="form-note" data-form-note hidden role="status" aria-live="polite"></p>
          <p class="contact__terms">
            By contacting us, you accept our Terms and Privacy Policy.
          </p>
        </form>
      </div>

      <aside class="contact-page__aside" aria-label="Contact details">
        <section class="contact-page__panel">
          <p class="kicker">(Newsletter)</p>
          <h3>Be the first to know what’s new.</h3>
          <form class="contact-page__newsletter" id="contactNewsletter" data-mail-form="newsletter">
            <label class="visually-hidden" for="contactNlEmail">E-mail</label>
            <input id="contactNlEmail" type="email" name="email" placeholder="E-mail" required autocomplete="email" />
            <button class="btn btn--dark" type="submit"><span>Subscribe</span></button>
            <p class="form-note" data-form-note hidden role="status" aria-live="polite"></p>
          </form>
          <p class="contact-page__fine">No noise. Just curated updates.</p>
        </section>

        <section class="contact-page__panel">
          <p class="kicker">(New Projects / Business)</p>
          <a href="mailto:info@vedha.ae">info@vedha.ae</a>
          <a href="tel:+971506583342">(+971) 50 658 3342</a>
        </section>

        <section class="contact-page__panel">
          <p class="kicker">(General Inquiries)</p>
          <a href="mailto:info@vedha.ae">info@vedha.ae</a>
        </section>

        <section class="contact-page__panel">
          <p class="kicker">(Location)</p>
          <p>Dubai,<br />United Arab Emirates</p>
        </section>

        <nav class="contact-page__panel" aria-label="Pages">
          <p class="kicker">(Pages)</p>
          <a href="/">Home</a>
          <a href="/#studio">Studio</a>
          <a href="/#work">Work</a>
          <a href="/services/">Services</a>
          <a href="/blog/">Blog</a>
          <a href="/contact/" aria-current="page">Contact</a>
        </nav>
      </aside>
    </div>
  </article>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
</BaseLayout>

<style>
  .contact-page {
    max-width: min(var(--content-max), 72rem);
    width: 100%;
    margin-inline: auto;
    padding:
      calc(4.5rem + clamp(1.2rem, 3vh, 2rem))
      var(--gutter)
      clamp(3rem, 8vh, 5rem);
  }
  .contact-page .scene-banner {
    margin-bottom: clamp(1.8rem, 4vh, 2.8rem);
  }
  .contact-page .scene-banner__title {
    width: min(96%, 12ch);
    font-size: clamp(2.4rem, 6vw, 4.8rem);
  }

  .contact-page__layout {
    display: grid;
    gap: clamp(2.4rem, 5vw, 3.5rem);
    align-items: start;
  }
  .contact-page__main {
    display: grid;
    gap: clamp(1.8rem, 4vh, 2.6rem);
    min-width: 0;
  }
  .contact-page__intro {
    display: grid;
    gap: 0.85rem;
    justify-items: start;
  }
  .contact-page__intro h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .contact-page__intro > p:not(.kicker) {
    margin: 0;
    color: var(--ink-soft);
    max-width: 36rem;
    line-height: 1.55;
    font-size: 1.05rem;
  }

  .contact-page__aside {
    display: grid;
    gap: 1rem;
  }
  .contact-page__panel {
    display: grid;
    gap: 0.55rem;
    padding: 1.25rem 1.3rem;
    border: 1px solid rgba(17, 17, 17, 0.08);
    border-radius: calc(var(--radius) * 0.75);
    background: var(--card);
  }
  .contact-page__panel h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .contact-page__panel a {
    color: var(--ink);
    text-decoration: none;
    font-size: 0.98rem;
  }
  .contact-page__panel a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .contact-page__panel p:not(.kicker) {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .contact-page__fine {
    font-size: 0.75rem;
    color: var(--ink-soft);
  }

  .contact-page__newsletter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    width: 100%;
  }
  .contact-page__newsletter input {
    flex: 1;
    min-width: 10rem;
    min-height: 48px;
    padding: 0 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    font: inherit;
    color: var(--ink);
    font-size: max(16px, 1em);
  }
  .contact-page__newsletter input:focus {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 3px rgba(17, 17, 17, 0.08);
  }

  @media (min-width: 64rem) {
    .contact-page__layout {
      grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
      gap: clamp(2.5rem, 4vw, 3.5rem);
    }
    .contact-page__aside {
      position: sticky;
      top: 6rem;
    }
  }
</style>
