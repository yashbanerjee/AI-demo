---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  ADDON_GROUPS,
  formatAed,
  getEstimatorCatalog,
} from "../../lib/estimator-catalog";
import {
  estimatorAddonSeo,
  estimatorBaseSeo,
} from "../../data/cost-estimator";
import {
  breadcrumbSchema,
  faqPageSchema,
  howToSchema,
  offerCatalogSchema,
  serviceSchema,
  webApplicationSchema,
} from "../../lib/schema";

const { bases: estimatorBases, addons: estimatorAddons, recommendedByBase } = await getEstimatorCatalog();

const catalog = {
  bases: estimatorBases,
  addons: estimatorAddons,
  recommendedByBase,
  groups: ADDON_GROUPS,
};

const steps = [
  { id: 1, label: "Base" },
  { id: 2, label: "Modules" },
  { id: 3, label: "Details" },
];

const groupLabel = (id: string) => ADDON_GROUPS.find((g) => g.id === id)?.label ?? id;

const pagePath = "/cost-estimator/";
const pageTitle = "Website Development Cost in Dubai | Price Calculator | Vedha";
const pageDescription =
  "Estimate website development cost in Dubai with Vedha's online website price calculator. Compare website design cost in AED, add modules, and send a live website price estimate.";
const prices = estimatorBases.map((base) => base.priceAed);
const lowPrice = prices.length ? Math.min(...prices) : 1500;
const highPrice = prices.length ? Math.max(...prices) : 85000;

const seoPackages = estimatorBases.map((base) => ({
  ...base,
  seoDescription: estimatorBaseSeo[base.id] ?? base.description,
}));

const seoModules = estimatorAddonSeo.map((item) => {
  const live = estimatorAddons.find((addon) => addon.id === item.id);
  return {
    ...item,
    priceAed: live?.priceAed,
  };
});

const faqs = [
  {
    question: "How do I use this website cost calculator?",
    answer:
      "Choose the website package that best matches your project, then add or remove modules such as payment gateways, SEO, CMS tools, analytics and integrations. Your estimate updates as you build your scope. Submit your details when you are ready and we will review the estimate before confirming the final requirements and quote.",
  },
  {
    question: "How much does website development cost in Dubai?",
    answer:
      "Website development cost in Dubai depends on the type of website, its scope and the systems it needs to connect with. A focused landing page costs less than an ecommerce store, marketplace or custom web application. Use the calculator to build an initial AED estimate, then confirm the final scope through discovery.",
  },
  {
    question: "How much does website design cost in Dubai?",
    answer:
      "Website design cost in Dubai depends on the number of pages, visual direction, content requirements and level of customisation. A template-led business website has a different scope from a fully custom corporate or multilingual experience. The calculator helps you compare starting packages and add the features your project needs.",
  },
  {
    question: "Is the website price estimate a final quote?",
    answer:
      "No. The calculator provides an indicative estimate based on typical UAE website scopes. The final quote depends on your confirmed requirements, content, integrations, technical complexity and delivery needs. We review your estimate and recommend the right next step before confirming the scope.",
  },
  {
    question: "What affects the cost of building a website in the UAE?",
    answer:
      "The main cost factors are the website type, number of pages, custom design, ecommerce or booking functionality, content, multilingual support, SEO, payment methods, third-party integrations and CMS requirements. Adding more workflows or connected systems usually increases the scope and delivery time.",
  },
  {
    question: "Do you only work with Dubai businesses?",
    answer:
      "No. Vedha is based in Dubai and works with businesses across the UAE and GCC. We build websites for companies in Abu Dhabi, Sharjah and other locations, including Arabic and English experiences, ecommerce stores, booking websites, custom web applications and connected digital systems.",
  },
];

const schemas = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Website development cost in Dubai", path: pagePath },
  ]),
  webApplicationSchema({
    name: "Website development cost calculator",
    description: pageDescription,
    path: pagePath,
    lowPrice,
    highPrice,
    offerCount: estimatorBases.length,
  }),
  offerCatalogSchema({
    name: "Website design cost in Dubai",
    description: "AED starter packages for website design and development cost in Dubai.",
    path: pagePath,
    offers: estimatorBases.map((base) => ({
      name: base.name,
      description: estimatorBaseSeo[base.id] ?? base.description,
      price: base.priceAed,
    })),
  }),
  serviceSchema({
    name: "Website development cost in Dubai",
    description: pageDescription,
    path: pagePath,
    services: estimatorBases.slice(0, 8).map((base) => ({
      name: base.name,
      description: estimatorBaseSeo[base.id] ?? base.description,
    })),
  }),
  howToSchema({
    name: "How to use the website price calculator",
    description: "Build a live website price estimate in AED in three steps.",
    path: pagePath,
    steps: [
      {
        name: "Choose your base package",
        text: "Select a website package such as a landing page, corporate site, ecommerce store, or custom web app.",
      },
      {
        name: "Choose your modules",
        text: "Add or remove modules. Recommended options appear first.",
      },
      {
        name: "Fill out your details",
        text: "Share your details so Vedha can review your estimate and recommend the right next step within 48 hours.",
      },
    ],
  }),
  faqPageSchema(faqs),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage="/images/photo-dubai-marina.jpg"
  ogImageAlt="Dubai marina skyline — website development cost in Dubai calculator"
>
  <article class="estimator" id="costEstimator" data-estimator data-header-dark data-step="1">
    <div class="estimator__glow" aria-hidden="true"></div>
    <div class="estimator__grain" aria-hidden="true"></div>
    <p class="visually-hidden" data-cart-announce aria-live="polite" aria-atomic="true"></p>

    <div class="estimator__stage">
      <header class="estimator__hero">
        <div class="estimator__hero-copy">
          <nav class="estimator__crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span>Website development cost in Dubai</span>
          </nav>
          <p class="estimator__kicker">Website Cost Calculator · AED</p>
          <h1 class="estimator__title">Calculate your website cost in Dubai</h1>
          <p class="estimator__lede">Need a website for your brand or business? Choose a starting package, add the features you need and get a live estimate of your website development cost in Dubai or the UAE.</p>
        </div>
        <nav aria-label="Estimator steps">
          <ol class="estimator-steps" data-stepper>
            {steps.map((step) => (
              <li>
                <button
                  type="button"
                  class:list={["estimator-steps__item", { "is-active": step.id === 1 }]}
                  data-step-indicator={String(step.id)}
                  data-go-step={String(step.id)}
                  aria-current={step.id === 1 ? "step" : undefined}
                  disabled={step.id !== 1}
                >
                  <span class="estimator-steps__num" aria-hidden="true">{String(step.id).padStart(2, "0")}</span>
                  <span class="estimator-steps__label">{step.label}</span>
                  <span class="estimator-steps__tick" aria-hidden="true">
                    <svg viewBox="0 0 12 12" width="10" height="10"><path d="M2 6.2l2.6 2.6L10 3.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </button>
              </li>
            ))}
          </ol>
        </nav>
      </header>

      <div class="estimator__layout">
        <div class="estimator__main" data-estimator-main>
          <!-- Step 1: Base -->
          <section class="estimator-panel is-active" data-panel="1" aria-labelledby="estimatorBasesHeading">
            <div class="estimator__section-head">
              <h2 id="estimatorBasesHeading" tabindex="-1">Choose your base package.</h2>
              <p>Website design costs in Dubai and the UAE. Choose a package, then adjust your estimate anytime.</p>
            </div>
            <div class="estimator__bases" role="radiogroup" aria-label="Base packages" data-base-group>
              {estimatorBases.map((base) => (
                <button
                  type="button"
                  class="estimator-base"
                  data-base-id={base.id}
                  data-base-price={String(base.priceAed)}
                  data-base-name={base.name}
                  role="radio"
                  aria-checked="false"
                >
                  <span class="estimator-base__media">
                    <img
                      src={base.image}
                      alt={`${base.name} website package in Dubai from ${formatAed(base.priceAed)}`}
                      width="640"
                      height="400"
                      loading={base.id === estimatorBases[0]?.id ? "eager" : "lazy"}
                      decoding="async"
                    />
                    <span class="estimator-check" aria-hidden="true">
                      <svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.4l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </span>
                  <span class="estimator-base__body">
                    <span class="estimator-base__top">
                      <span class="estimator-base__name">{base.name}</span>
                      <span class="estimator-base__price">{formatAed(base.priceAed)}</span>
                    </span>
                    <span class="estimator-base__desc">{base.description}</span>
                    <span class="estimator-base__meta">
                      <span>{base.weeksMin}–{base.weeksMax} weeks</span>
                      <span class="estimator-base__state" data-base-state>Select</span>
                    </span>
                  </span>
                </button>
              ))}
            </div>
            <div class="estimator-nav">
              <button type="button" class="btn btn--light" data-next-step disabled>
                <span>Continue to modules</span>
              </button>
            </div>
          </section>

          <!-- Step 2: Modules -->
          <section class="estimator-panel" data-panel="2" aria-labelledby="estimatorAddonsHeading" hidden>
            <div class="estimator__section-head">
              <h2 id="estimatorAddonsHeading" tabindex="-1">Choose your modules</h2>
              <p>Add or remove modules. Recommended options appear first.</p>
            </div>

            <div class="estimator__chips" data-addon-chips role="tablist" aria-label="Filter modules">
              {ADDON_GROUPS.map((group, i) => (
                <button
                  type="button"
                  class:list={["estimator-chip", { "is-active": i === 0 }]}
                  data-filter={group.id}
                  role="tab"
                  aria-selected={i === 0 ? "true" : "false"}
                >
                  {group.label}
                </button>
              ))}
            </div>

            <div class="estimator__addons" data-addon-grid aria-live="polite">
              {estimatorAddons.map((addon) => (
                <button
                  type="button"
                  class="estimator-addon"
                  data-addon-id={addon.id}
                  data-addon-price={String(addon.priceAed)}
                  data-addon-name={addon.name}
                  data-addon-group={addon.group}
                  data-addon-popular={addon.popular ? "1" : "0"}
                  aria-pressed="false"
                >
                  <span class="estimator-addon__media">
                    <img
                      src={addon.image}
                      alt={`${addon.name} website module from ${formatAed(addon.priceAed)}`}
                      width="480"
                      height="300"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="estimator-check" aria-hidden="true">
                      <svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.4l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </span>
                  <span class="estimator-addon__body">
                    <span class="estimator-addon__badges">
                      <span class="estimator-badge">{groupLabel(addon.group)}</span>
                      {addon.popular && <span class="estimator-badge estimator-badge--popular">Popular</span>}
                      <span class="estimator-badge estimator-badge--rec" data-rec-badge hidden>Recommended</span>
                    </span>
                    <span class="estimator-addon__top">
                      <span class="estimator-addon__name">{addon.name}</span>
                      <span class="estimator-addon__price">{formatAed(addon.priceAed)}</span>
                    </span>
                    <span class="estimator-addon__desc">{addon.description}</span>
                    <span class="estimator-addon__foot">
                      <span class="estimator-addon__meta">
                        {addon.weeksExtra > 0 ? `+${addon.weeksExtra} wk${addon.weeksExtra === 1 ? "" : "s"}` : "No extra time"}
                      </span>
                      <span class="estimator-addon__action" data-addon-action>Add</span>
                    </span>
                  </span>
                </button>
              ))}
            </div>
            <p class="estimator__empty" data-addons-empty hidden>No modules in this filter. Try another chip.</p>

            <div class="estimator-nav">
              <button type="button" class="btn btn--ghost" data-prev-step><span>Back to base</span></button>
              <button type="button" class="btn btn--light" data-next-step><span>Get your estimate</span></button>
            </div>
          </section>

          <!-- Step 3: Details -->
          <section class="estimator-panel" data-panel="3" aria-labelledby="estimatorSendHeading" hidden>
            <div class="estimator__section-head">
              <h2 id="estimatorSendHeading" tabindex="-1">Fill out your details</h2>
              <p>We'll review your estimate and recommend the right next step within 48 hours.</p>
            </div>

            <div class="estimator-details">
              <form class="estimator-form" data-mail-form="cost-estimate" data-estimator-form novalidate>
                <input type="hidden" name="base" data-field-base value="" />
                <input type="hidden" name="addons" data-field-addons value="" />
                <input type="hidden" name="totalAed" data-field-total value="0" />
                <input type="hidden" name="description" data-field-description value="" />
                <input type="hidden" name="deliveryEstimate" data-field-delivery value="" />
                <input type="hidden" name="service" value="cost-estimator" />

                <div class="estimator-form__grid">
                  <div class="estimator-field">
                    <label for="estName">Name</label>
                    <input id="estName" type="text" name="name" placeholder="Your name" required autocomplete="name" />
                  </div>
                  <div class="estimator-field">
                    <label for="estEmail">Email</label>
                    <input id="estEmail" type="email" name="email" placeholder="you@company.com" required autocomplete="email" inputmode="email" />
                  </div>
                  <div class="estimator-field">
                    <label for="estPhone">Phone number</label>
                    <input id="estPhone" type="tel" name="phone" placeholder="+971 50 000 0000" required autocomplete="tel" inputmode="tel" />
                  </div>
                  <div class="estimator-field">
                    <label for="estPref">Preferred delivery timing</label>
                    <div class="estimator-select">
                      <select id="estPref" name="deliveryPreference" required data-delivery-preference>
                        <option value="" disabled selected>Select a preference</option>
                        <option value="As soon as possible">As soon as possible</option>
                        <option value="Match the estimate">Match the estimate</option>
                        <option value="Flexible / no rush">Flexible / no rush</option>
                        <option value="Need a fixed deadline">Need a fixed deadline</option>
                      </select>
                    </div>
                  </div>
                  <div class="estimator-field estimator-field--full">
                    <label for="estNotes">Notes <span class="estimator-form__optional">(optional)</span></label>
                    <textarea id="estNotes" name="notes" rows="3" placeholder="Deadline, must-haves, or context we should know"></textarea>
                  </div>
                </div>

                <p class="form-note form-note--light" data-form-note hidden role="status" aria-live="polite"></p>

                <div class="estimator-nav estimator-nav--form">
                  <button type="button" class="btn btn--ghost" data-prev-step><span>Back to modules</span></button>
                  <button class="btn btn--light" type="submit" data-submit-estimate disabled>
                    <span>Send estimate</span>
                  </button>
                </div>
                <p class="estimator__disclaimer">
                  Indicative estimate for typical UAE website projects. Final quote confirmed after discovery.
                </p>
              </form>

              <aside class="estimator-delivery" data-delivery-card aria-label="Estimated delivery">
                <p class="estimator__kicker">Estimated delivery</p>
                <p class="estimator-delivery__value" data-delivery-label>—</p>
                <p class="estimator-delivery__note">Based on your base and modules. We confirm the timeline after a short discovery call.</p>
                <dl class="estimator-delivery__facts">
                  <div><dt>Base</dt><dd data-summary-base>—</dd></div>
                  <div><dt>Modules</dt><dd data-summary-modules>0</dd></div>
                  <div><dt>Total</dt><dd data-summary-total>AED 0</dd></div>
                </dl>
              </aside>
            </div>

            <div class="estimator-success" data-estimator-success hidden role="status">
              <span class="estimator-success__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <div>
                <p class="estimator-success__title">Estimate sent</p>
                <p class="estimator-success__text">We've received your estimate and will reply within 48 hours.</p>
              </div>
              <button type="button" class="btn btn--ghost" data-reset-estimator><span>Start another</span></button>
            </div>
          </section>
        </div>

        <aside class="estimator-cart" data-cart aria-label="Your estimate">
          <div class="estimator-cart__panel">
            <header class="estimator-cart__head">
              <p class="estimator__kicker">Your estimate</p>
              <span class="estimator-cart__count" data-cart-count>0 items</span>
            </header>
            <ul class="estimator-cart__lines" data-cart-lines>
              <li class="estimator-cart__empty" data-cart-empty>Select a base to begin.</li>
            </ul>
            <div class="estimator-cart__foot">
              <div class="estimator-cart__meta">
                <span>Delivery</span>
                <strong data-delivery-label-cart>—</strong>
              </div>
              <div class="estimator-cart__total">
                <span>Total</span>
                <strong data-cart-total>AED 0</strong>
              </div>
              <button type="button" class="btn btn--light btn--wide" data-cart-continue disabled>
                <span data-cart-continue-label>Continue</span>
              </button>
              <button type="button" class="estimator-cart__back" data-cart-back hidden>← Back a step</button>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <div class="estimator-dock" data-cart-dock>
      <button type="button" class="estimator-dock__toggle" data-cart-open aria-expanded="false" aria-controls="estimatorSheet">
        <span data-dock-count>0 items</span>
        <strong data-dock-total>AED 0</strong>
      </button>
      <button type="button" class="btn btn--light" data-cart-continue data-dock-continue disabled>
        <span>Next</span>
      </button>
    </div>

    <div class="estimator-sheet" id="estimatorSheet" data-cart-sheet hidden>
      <div class="estimator-sheet__backdrop" data-cart-close></div>
      <div class="estimator-sheet__panel" role="dialog" aria-modal="true" aria-label="Your estimate">
        <header class="estimator-sheet__head">
          <p class="estimator__kicker">Your estimate</p>
          <button type="button" class="estimator-sheet__close" data-cart-close aria-label="Close">×</button>
        </header>
        <ul class="estimator-cart__lines" data-cart-lines-mobile></ul>
        <div class="estimator-cart__meta">
          <span>Delivery</span>
          <strong data-delivery-label-mobile>—</strong>
        </div>
        <div class="estimator-cart__total">
          <span>Total</span>
          <strong data-cart-total-mobile>AED 0</strong>
        </div>
        <button type="button" class="btn btn--light btn--wide" data-cart-continue data-cart-close>
          <span>Continue</span>
        </button>
      </div>
    </div>
  </article>

  <section class="estimator-seo" aria-labelledby="estimatorSeoHeading">
    <p class="kicker">(Website price calculator)</p>
    <h2 class="statement" id="estimatorSeoHeading">Website development cost in Dubai, by package</h2>
    <p class="section-lead">
      Build a live website price estimate with our website development cost calculator. Choose a base for landing pages, corporate websites, ecommerce stores or custom web apps, then add payments, SEO, CMS tools and integrations.
    </p>
    <p class="section-lead">
      Send your estimate and the Vedha team will review it within 48 hours, or <a href="/contact/">book a free consultation</a> right away.
    </p>
    <ul class="estimator-seo__packages">
      {seoPackages.map((base) => (
        <li>
          <strong>{base.name}</strong>
          <span>{formatAed(base.priceAed)} · {base.weeksMin}–{base.weeksMax} weeks</span>
          <p>{base.seoDescription}</p>
        </li>
      ))}
    </ul>
    <div class="estimator-seo__modules">
      <p class="kicker">(Modules)</p>
      <ul>
        {seoModules.map((addon) => (
          <li>
            <strong>{addon.name}</strong>
            {typeof addon.priceAed === "number" && <span>{formatAed(addon.priceAed)}</span>}
            <p>{addon.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="faq" id="faq">
    <figure class="scene-banner" data-scene-banner>
      <picture>
        <img
          src="/images/photo-mountain-mist.jpg"
          alt=""
          width="1600"
          height="1067"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
      </picture>
      <h2 class="scene-banner__title">FAQs</h2>
      <figcaption class="scene-banner__meta">
        <span>Answers</span>
        <span>Website development cost · Dubai</span>
      </figcaption>
    </figure>
    <div class="faq__list">
      {faqs.map((item, i) => (
        <details class="faq__item" data-reveal>
          <summary>
            <span>{String(i + 1).padStart(2, "0")}</span>
            {item.question}
            <i aria-hidden="true"></i>
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
    <aside class="faq__more" data-reveal>
      <figure class="faq__more-media" aria-hidden="true">
        <img src="/images/photo-waterfall.jpg" alt="" width="720" height="436" loading="lazy" decoding="async" />
      </figure>
      <div class="faq__more-copy">
        <p class="kicker">(Ready to build?)</p>
        <h4>Turn your website estimate into a clear plan.</h4>
        <p class="faq__more-text">
          Send us your calculator results or book a short call. We'll review your scope, confirm what it involves, and recommend the right next step.
        </p>
        <a class="btn btn--dark" href="/#book" data-book-consultation><span>Book a free 30-minute consultation</span></a>
      </div>
    </aside>
  </section>

  <script id="estimator-catalog" type="application/json" set:html={JSON.stringify(catalog)} />
  <script src="../../scripts/cost-estimator.js"></script>
  {schemas.map((schema) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  ))}
</BaseLayout>
<style is:global>
  /* —— Exclusive dark studio —— */
  body:has(.estimator) { background: var(--bg); }

  .estimator {
    --studio-bg: #070707;
    --studio-panel: #121212;
    --studio-elevated: #1a1a1a;
    --studio-line: rgba(255, 255, 255, 0.1);
    --studio-ink: #f4f2ee;
    --studio-mute: rgba(244, 242, 238, 0.58);
    --studio-accent: #d4b483;
    --studio-accent-soft: rgba(212, 180, 131, 0.16);
    --studio-shadow: 0 24px 64px rgba(0, 0, 0, 0.55), 0 1px 0 rgba(255, 255, 255, 0.04) inset;
    --fast: 0.18s;
    --med: 0.3s;
    position: relative;
    isolation: isolate;
    width: 100%;
    background:
      radial-gradient(ellipse 90% 55% at 15% -10%, rgba(212, 180, 131, 0.12), transparent 55%),
      radial-gradient(ellipse 70% 50% at 90% 10%, rgba(90, 110, 140, 0.1), transparent 50%),
      radial-gradient(ellipse 60% 40% at 50% 100%, rgba(255, 255, 255, 0.03), transparent 55%),
      var(--studio-bg);
    color: var(--studio-ink);
    overflow: clip;
  }
  .estimator :focus-visible {
    outline: 2px solid var(--studio-accent);
    outline-offset: 3px;
    border-radius: 0.5rem;
  }

  .estimator__glow {
    pointer-events: none;
    position: absolute;
    inset: -20% 20% auto;
    height: 40%;
    background: radial-gradient(circle, rgba(212, 180, 131, 0.08), transparent 70%);
    filter: blur(40px);
    z-index: 0;
  }
  .estimator__grain {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.35;
    mix-blend-mode: soft-light;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.55'/%3E%3C/svg%3E");
    background-size: 180px;
  }

  .estimator__stage {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding: 7.25rem max(var(--gutter), env(safe-area-inset-right)) 1.25rem max(var(--gutter), env(safe-area-inset-left));
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  @media (min-width: 64rem) {
    .estimator__stage {
      height: 100vh;
      height: 100dvh;
      min-height: 36rem;
    }
  }

  .estimator__kicker {
    margin: 0;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--studio-accent);
    font-weight: 600;
  }

  .estimator__hero {
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.55rem 1.25rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--studio-line);
  }
  .estimator__hero-copy { display: grid; gap: 0.15rem; max-width: 44rem; }
  .estimator__crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.35rem;
    font-size: 0.72rem;
    color: rgba(244, 242, 238, 0.45);
  }
  .estimator__crumbs a { color: inherit; }
  .estimator__crumbs a:hover { color: var(--studio-ink); }
  .estimator__title {
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--studio-ink);
  }
  .estimator__lede { color: var(--studio-mute); font-size: 0.82rem; line-height: 1.35; }

  /* Stepper (clickable once reachable) */
  .estimator-steps { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; }
  .estimator-steps__item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.15rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--studio-line);
    color: var(--studio-mute);
    font: inherit;
    font-size: 0.78rem;
    background: rgba(255, 255, 255, 0.02);
    cursor: pointer;
    transition: background var(--fast), color var(--fast), border-color var(--fast), box-shadow var(--med), transform var(--fast);
  }
  .estimator-steps__item:disabled { cursor: not-allowed; opacity: 0.55; }
  .estimator-steps__item:not(:disabled):hover { border-color: rgba(255, 255, 255, 0.3); color: var(--studio-ink); }
  .estimator-steps__item.is-active {
    background: var(--studio-accent-soft);
    border-color: rgba(212, 180, 131, 0.5);
    color: var(--studio-ink);
    box-shadow: 0 0 24px rgba(212, 180, 131, 0.14);
    opacity: 1;
  }
  .estimator-steps__item.is-done { border-color: rgba(255, 255, 255, 0.22); color: rgba(244, 242, 238, 0.85); opacity: 1; }
  .estimator-steps__num { font-variant-numeric: tabular-nums; font-weight: 600; letter-spacing: 0.04em; color: var(--studio-accent); }
  .estimator-steps__tick { display: none; color: var(--studio-accent); }
  .estimator-steps__item.is-done .estimator-steps__num { display: none; }
  .estimator-steps__item.is-done .estimator-steps__tick { display: inline-flex; }

  /* Layout */
  .estimator__layout {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    gap: 1rem;
    align-items: stretch;
  }
  @media (min-width: 64rem) {
    .estimator__layout { grid-template-columns: minmax(0, 1fr) minmax(17rem, 21rem); gap: 1.15rem; }
    .estimator__main {
      min-height: 0;
      height: 100%;
      overflow: auto;
      padding-right: 0.35rem;
      scrollbar-width: thin;
      scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
      scroll-behavior: smooth;
    }
  }

  .estimator-panel {
    display: none;
    gap: 0.6rem;
    align-content: start;
    padding: 0;
    margin: 0;
  }
  .estimator-panel.is-active { display: grid; animation: estimator-panel-in var(--med) var(--ease-out); }
  @keyframes estimator-panel-in {
    from { opacity: 0; transform: translateY(0.35rem); }
    to { opacity: 1; transform: none; }
  }

  .estimator__section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.2rem 1rem;
  }
  .estimator__section-head h2 { font-size: 0.95rem; letter-spacing: -0.02em; font-weight: 600; outline: none; }
  .estimator__section-head p { color: var(--studio-mute); font-size: 0.78rem; }

  /* Shared check badge on media */
  .estimator-check {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--studio-accent);
    color: #1a1408;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.45);
    transform: scale(0.4);
    opacity: 0;
    transition: transform var(--fast) var(--ease-spring), opacity var(--fast);
  }
  [aria-checked="true"] .estimator-check,
  [aria-pressed="true"] .estimator-check { transform: scale(1); opacity: 1; }

  /* Bases */
  .estimator__bases { display: grid; gap: 0.55rem; grid-template-columns: 1fr; }
  @media (min-width: 36rem) { .estimator__bases { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 52rem) { .estimator__bases { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 90rem) { .estimator__bases { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .estimator-base {
    text-align: left;
    display: grid;
    grid-template-rows: auto 1fr;
    padding: 0;
    overflow: hidden;
    border-radius: 0.85rem;
    border: 1px solid var(--studio-line);
    background: var(--studio-panel);
    color: inherit;
    cursor: pointer;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
    transition: border-color var(--fast), transform var(--fast) var(--ease-out), box-shadow var(--med) var(--ease-out), background var(--fast);
  }
  .estimator-base:hover { transform: translateY(-2px); border-color: rgba(255, 255, 255, 0.22); box-shadow: var(--studio-shadow); }
  .estimator-base:active { transform: scale(0.985); transition-duration: 0.08s; }
  .estimator-base[aria-checked="true"] {
    border-color: rgba(212, 180, 131, 0.7);
    background: #161410;
    box-shadow: 0 0 0 1px rgba(212, 180, 131, 0.4), 0 18px 40px rgba(0, 0, 0, 0.5), 0 0 36px rgba(212, 180, 131, 0.14);
  }
  .estimator-base__media {
    position: relative;
    display: block;
    width: 100%;
    min-width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
  }
  .estimator-base__media img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    opacity: 0.92;
    transition: transform 0.6s var(--ease-out), opacity var(--fast);
  }
  .estimator-base:hover .estimator-base__media img,
  .estimator-base[aria-checked="true"] .estimator-base__media img { transform: scale(1.05); opacity: 1; }
  .estimator-base__body { display: grid; gap: 0.25rem; padding: 0.55rem 0.7rem 0.6rem; align-content: start; }
  .estimator-base__top { display: flex; justify-content: space-between; gap: 0.5rem; align-items: baseline; }
  .estimator-base__name { font-weight: 600; letter-spacing: -0.02em; font-size: 0.92rem; line-height: 1.25; }
  .estimator-base__price { font-variant-numeric: tabular-nums; font-size: 0.78rem; color: var(--studio-accent); white-space: nowrap; font-weight: 600; }
  .estimator-base__desc {
    color: var(--studio-mute);
    font-size: 0.75rem;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .estimator-base__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.66rem;
    color: rgba(244, 242, 238, 0.45);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding-top: 0.15rem;
  }
  .estimator-base__state { font-weight: 600; color: rgba(244, 242, 238, 0.7); transition: color var(--fast); }
  .estimator-base[aria-checked="true"] .estimator-base__state { color: var(--studio-accent); }

  /* Chips */
  .estimator__chips { display: flex; flex-wrap: nowrap; gap: 0.4rem; overflow-x: auto; padding-bottom: 0.15rem; scrollbar-width: thin; -webkit-overflow-scrolling: touch; }
  .estimator-chip {
    flex: 0 0 auto;
    min-height: 2.15rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--studio-line);
    background: rgba(255, 255, 255, 0.03);
    color: var(--studio-mute);
    font-size: 0.78rem;
    cursor: pointer;
    transition: background var(--fast), color var(--fast), border-color var(--fast), transform var(--fast);
  }
  .estimator-chip:hover { color: var(--studio-ink); border-color: rgba(255, 255, 255, 0.28); }
  .estimator-chip:active { transform: scale(0.96); }
  .estimator-chip.is-active { background: var(--studio-accent-soft); color: var(--studio-ink); border-color: rgba(212, 180, 131, 0.5); }

  /* Modules */
  .estimator__addons { display: grid; gap: 0.55rem; grid-template-columns: 1fr; }
  /* Author `display: grid` would otherwise override the hidden attribute */
  .estimator-addon[hidden],
  .estimator-addon.is-filtered-out {
    display: none !important;
  }
  @media (min-width: 40rem) { .estimator__addons { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 80rem) { .estimator__addons { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .estimator-addon {
    position: relative;
    text-align: left;
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: stretch;
    min-height: 6.25rem;
    padding: 0;
    overflow: hidden;
    border-radius: 0.75rem;
    border: 1px solid var(--studio-line);
    background: var(--studio-panel);
    color: inherit;
    cursor: pointer;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.3);
    transition: border-color var(--fast), transform var(--fast) var(--ease-out), box-shadow var(--med) var(--ease-out), background var(--fast);
  }
  .estimator-addon:hover { transform: translateY(-1px); border-color: rgba(255, 255, 255, 0.22); box-shadow: var(--studio-shadow); }
  .estimator-addon:active { transform: scale(0.985); transition-duration: 0.08s; }
  .estimator-addon[aria-pressed="true"] {
    border-color: rgba(212, 180, 131, 0.7);
    background: #161410;
    box-shadow: 0 0 0 1px rgba(212, 180, 131, 0.35), 0 14px 32px rgba(0, 0, 0, 0.45), 0 0 28px rgba(212, 180, 131, 0.12);
  }
  .estimator-addon.is-recommended:not([aria-pressed="true"]) { border-color: rgba(212, 180, 131, 0.3); }
  .estimator-addon__media { position: relative; display: block; min-height: 100%; background: #000; overflow: hidden; }
  .estimator-addon__media img { width: 100%; height: 100%; object-fit: cover; opacity: 0.9; transition: transform 0.6s var(--ease-out); }
  .estimator-addon:hover .estimator-addon__media img { transform: scale(1.06); }
  .estimator-addon__media .estimator-check { top: 0.35rem; right: 0.35rem; width: 1.35rem; height: 1.35rem; }
  .estimator-addon__body { display: grid; gap: 0.28rem; align-content: start; padding: 0.55rem 0.7rem 0.55rem; }
  .estimator-addon__badges { display: flex; flex-wrap: wrap; gap: 0.25rem; min-height: 0.95rem; }
  .estimator-badge {
    font-size: 0.58rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    font-weight: 600;
    padding: 0.12rem 0.38rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--studio-mute);
  }
  .estimator-badge--popular { background: rgba(212, 180, 131, 0.18); color: var(--studio-accent); }
  .estimator-badge--rec { background: rgba(244, 242, 238, 0.92); color: #111; }
  .estimator-addon__top { display: flex; justify-content: space-between; gap: 0.45rem; align-items: baseline; }
  .estimator-addon__name { font-weight: 600; letter-spacing: -0.02em; font-size: 0.86rem; line-height: 1.25; }
  .estimator-addon__price { font-variant-numeric: tabular-nums; font-size: 0.74rem; color: var(--studio-accent); white-space: nowrap; font-weight: 600; }
  .estimator-addon__desc { color: var(--studio-mute); font-size: 0.73rem; line-height: 1.4; }
  .estimator-addon__foot { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; padding-top: 0.1rem; }
  .estimator-addon__meta { font-size: 0.64rem; letter-spacing: 0.05em; text-transform: uppercase; color: rgba(244, 242, 238, 0.45); }
  .estimator-addon__action {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: rgba(244, 242, 238, 0.85);
    transition: background var(--fast), color var(--fast), border-color var(--fast);
  }
  .estimator-addon:hover .estimator-addon__action { border-color: rgba(255, 255, 255, 0.4); }
  .estimator-addon[aria-pressed="true"] .estimator-addon__action { background: var(--studio-accent); border-color: var(--studio-accent); color: #1a1408; }

  .estimator__empty { color: var(--studio-mute); padding: 0.5rem 0; font-size: 0.88rem; }

  /* Navigation rows */
  .estimator-nav { display: flex; flex-wrap: wrap; gap: 0.55rem; align-items: center; padding-top: 0.35rem; }
  @media (min-width: 64rem) { .estimator-panel[data-panel="1"] .estimator-nav { display: none; } }
  .estimator .btn { transition-duration: 0.22s; }
  .estimator .btn--ghost { border-color: rgba(255, 255, 255, 0.22); color: var(--studio-ink); background: rgba(255, 255, 255, 0.03); }
  .estimator .btn--ghost:hover { background: rgba(255, 255, 255, 0.12); color: #fff; }
  .estimator .btn--light { box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45); }
  .estimator .btn:disabled { opacity: 0.45; cursor: not-allowed; box-shadow: none; transform: none; }
  .estimator .btn:disabled::before { display: none; }

  /* Details step */
  .estimator-details { display: grid; gap: 0.85rem; align-items: start; }
  @media (min-width: 64rem) { .estimator-details { grid-template-columns: minmax(0, 1fr) 17rem; } }

  .estimator-form {
    display: grid;
    gap: 0.85rem;
    padding: 1rem;
    border-radius: 0.95rem;
    border: 1px solid var(--studio-line);
    background: var(--studio-panel);
    box-shadow: var(--studio-shadow);
  }
  .estimator-form__grid { display: grid; gap: 0.7rem; grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .estimator-form__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .estimator-field { display: grid; gap: 0.3rem; min-width: 0; }
  .estimator-field--full { grid-column: 1 / -1; }
  .estimator-field label { font-size: 0.74rem; letter-spacing: 0.02em; color: var(--studio-mute); font-weight: 500; }
  .estimator-field:focus-within label { color: var(--studio-ink); }
  .estimator-form__optional { color: rgba(244, 242, 238, 0.4); font-weight: 400; }
  .estimator-field input,
  .estimator-field select,
  .estimator-field textarea {
    width: 100%;
    min-height: 2.85rem;
    padding: 0.65rem 0.85rem;
    border-radius: 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: var(--studio-elevated);
    color: var(--studio-ink);
    font: inherit;
    font-size: max(16px, 0.92rem);
    line-height: 1.3;
    color-scheme: dark;
    transition: border-color var(--fast), box-shadow var(--fast), background var(--fast);
  }
  .estimator-field input::placeholder,
  .estimator-field textarea::placeholder { color: rgba(244, 242, 238, 0.35); }
  .estimator-field textarea { min-height: 5.5rem; resize: vertical; line-height: 1.45; }
  .estimator-field input:hover,
  .estimator-field select:hover,
  .estimator-field textarea:hover { border-color: rgba(255, 255, 255, 0.28); }
  .estimator-field input:focus,
  .estimator-field select:focus,
  .estimator-field textarea:focus {
    outline: none;
    border-color: rgba(212, 180, 131, 0.7);
    box-shadow: 0 0 0 3px rgba(212, 180, 131, 0.18);
    background: #1e1c18;
  }
  .estimator-field input:user-invalid,
  .estimator-field select:user-invalid { border-color: rgba(255, 130, 110, 0.7); }
  .estimator-select { position: relative; }
  .estimator-select select { appearance: none; padding-right: 2.4rem; cursor: pointer; }
  .estimator-select::after {
    content: "";
    position: absolute;
    right: 0.95rem;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1.5px solid var(--studio-mute);
    border-bottom: 1.5px solid var(--studio-mute);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }
  .estimator-select select option { background: #1a1a1a; color: var(--studio-ink); }
  .estimator-nav--form { justify-content: space-between; padding-top: 0.1rem; }
  .estimator .form-note { margin: 0; border-radius: 0.5rem; }
  .estimator__disclaimer { margin: 0; color: rgba(244, 242, 238, 0.42); font-size: 0.74rem; line-height: 1.4; }

  .estimator-delivery {
    background: linear-gradient(165deg, rgba(212, 180, 131, 0.1), rgba(18, 18, 18, 0.9) 60%);
    border: 1px solid rgba(212, 180, 131, 0.25);
    border-radius: 0.95rem;
    padding: 1rem 1.05rem;
    display: grid;
    gap: 0.35rem;
    box-shadow: var(--studio-shadow);
  }
  .estimator-delivery__value { font-size: clamp(1.4rem, 2.5vw, 1.8rem); font-weight: 600; letter-spacing: -0.02em; color: var(--studio-accent); line-height: 1.1; }
  .estimator-delivery__note { color: var(--studio-mute); font-size: 0.76rem; line-height: 1.4; }
  .estimator-delivery__facts { margin: 0.5rem 0 0; display: grid; gap: 0.35rem; border-top: 1px solid var(--studio-line); padding-top: 0.6rem; }
  .estimator-delivery__facts div { display: flex; justify-content: space-between; gap: 0.75rem; font-size: 0.78rem; }
  .estimator-delivery__facts dt { color: var(--studio-mute); }
  .estimator-delivery__facts dd { margin: 0; font-weight: 600; text-align: right; }

  .estimator-success {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 0.85rem;
    align-items: center;
    padding: 1rem 1.05rem;
    border-radius: 0.95rem;
    border: 1px solid rgba(212, 180, 131, 0.45);
    background: linear-gradient(165deg, rgba(212, 180, 131, 0.14), rgba(18, 18, 18, 0.95) 65%);
    box-shadow: var(--studio-shadow);
    animation: estimator-panel-in var(--med) var(--ease-out);
  }
  .estimator-success[hidden] { display: none; }
  .estimator-success__icon { width: 2.4rem; height: 2.4rem; display: grid; place-items: center; border-radius: 999px; background: var(--studio-accent); color: #1a1408; }
  .estimator-success__title { font-weight: 600; font-size: 1rem; }
  .estimator-success__text { color: var(--studio-mute); font-size: 0.82rem; }
  .estimator-success .btn { grid-column: 1 / -1; justify-self: start; }

  /* Cart — side console */
  .estimator-cart { display: none; }
  @media (min-width: 64rem) { .estimator-cart { display: block; height: 100%; min-height: 0; } }
  .estimator-cart__panel {
    background: linear-gradient(165deg, rgba(28, 28, 28, 0.96), rgba(14, 14, 14, 0.98));
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    padding: 1rem 1.05rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    min-height: 0;
    box-shadow: var(--studio-shadow);
  }
  .estimator-cart__head { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
  .estimator-cart__count { font-size: 0.72rem; color: var(--studio-mute); font-variant-numeric: tabular-nums; }
