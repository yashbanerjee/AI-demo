---
import { pillars } from "../data/services.js";

const servicesCount = pillars.reduce((n, p) => n + p.categories.length, 0);
---
<header class="site-header" id="siteHeader">
  <a href="/" class="site-header__logo" aria-label="Vedha home">
    <img class="site-header__logo-img" src="/images/vedha-logo.png" alt="VEDHA" width="1483" height="158" />
  </a>
  <nav class="site-header__nav" aria-label="Primary">
    <a href="/">Home</a>
    <a class="site-header__studio" href="/cost-estimator/">
      <span class="site-header__studio-label">Studio</span>
      <span class="site-header__try">Must Try</span>
    </a>
    <a href="/#work">Work <sup>(4)</sup></a>
    <a href="/services/">Services <sup>({servicesCount})</sup></a>
    <a href="/blog/">Blog</a>
    <a href="/contact/">Contact</a>
  </nav>
  <button class="menu-toggle" id="menuToggle" aria-expanded="false" aria-controls="menuOverlay" aria-label="Open menu">
    <span></span><span></span>
  </button>
</header>
