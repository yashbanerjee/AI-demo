---
/**
 * Google Analytics 4 (gtag.js)
 * Set PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX in .env (and production host env).
 * Omitted when the ID is missing, and only injected in production builds.
 */
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() || "";
const enabled = Boolean(measurementId) && import.meta.env.PROD;
---
{
  enabled && (
    <script
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}
    />
  )
}
{
  enabled && (
    <script is:inline define:vars={{ measurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag("js", new Date());
      gtag("config", measurementId, {
        anonymize_ip: true,
        send_page_view: true,
      });
    </script>
  )
}
