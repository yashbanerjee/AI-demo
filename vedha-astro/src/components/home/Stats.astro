---
const cards = [
  {
    label: "Experience brought into Vedha",
    count: 10,
    suffix: "+",
    blurb: "Strategy, tech and sharp thinking.",
  },
  {
    label: "Solutions delivered",
    count: 120,
    suffix: "+",
    blurb: "Products, platforms and systems across industries.",
  },
  {
    label: "Client satisfaction",
    count: 98,
    suffix: "%",
    blurb: "Trust earned through the work.",
  },
  {
    label: "Long-term relationships",
    count: 100,
    suffix: "+",
    blurb: "Partnerships built to last.",
  },
];
---

<!-- ===== Stats ===== -->
<section class="stats" id="stats">
  <figure class="scene-banner" data-scene-banner>
    <picture>
      <img
        src="/images/photo-alpine-glow.jpg"
        alt="Vedha project experience across UAE and GCC businesses"
        width="1600"
        height="1068"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <h2 class="scene-banner__title">Experience behind every build.</h2>
    <figcaption class="scene-banner__meta">
      <span>Outcomes</span>
      <a href="/contact/">Let’s talk</a>
    </figcaption>
  </figure>
  <p class="stats__lead" data-reveal>
    Vedha brings proven experience in building the systems, products and workflows that help businesses operate and grow. Our clients trust us to turn complex challenges into technology they can rely on.
  </p>
  <div class="stats__grid">
    {cards.map((card) => (
      <article class="stat-card stat-card--compact" data-reveal>
        <header class="stat-card__top">
          <p class="stat-card__label">{card.label}</p>
          <p
            class="stat-card__num"
            data-count={String(card.count)}
            data-suffix={card.suffix}
          >{card.count}{card.suffix}</p>
          <p class="stat-card__blurb">{card.blurb}</p>
        </header>
      </article>
    ))}
  </div>
</section>

<style is:global>
  .stat-card--compact {
    justify-content: center;
  }

  .stat-card--compact .stat-card__top {
    gap: 0.65rem;
  }
</style>
