<!-- ===== Process: 3D card stack → lined-up finale ===== -->
<section class="process" id="vision">
  <div class="process__sticky">
    <header class="process__head">
      <div class="process__intro">
        <p class="kicker kicker--light">(Our Process)</p>
        <p class="process__lead">
          Good software starts before a single line of code is written. Vedha runs projects in five stages: Discover, Chart, Validate, Engineer, Scale.
        </p>
      </div>
      <p class="process__count" id="processCount" aria-hidden="true">
        <span id="processCurrent">01</span><span>/</span><span>05</span>
      </p>
    </header>

    <div class="process__stage" id="processStage">
      <article class="process-card is-active" data-process-card>
        <span class="process-card__num">01</span>
        <h3>Discover</h3>
        <p>Understand the opportunity, systems and constraints before committing to a build.</p>
      </article>
      <article class="process-card" data-process-card>
        <span class="process-card__num">02</span>
        <h3>Chart</h3>
        <p>Set the roadmap, milestones, scope and priorities before work begins.</p>
      </article>
      <article class="process-card" data-process-card>
        <span class="process-card__num">03</span>
        <h3>Validate</h3>
        <p>Test the direction early, before decisions become expensive to change.</p>
      </article>
      <article class="process-card" data-process-card>
        <span class="process-card__num">04</span>
        <h3>Engineer</h3>
        <p>Build with senior engineers across web apps, ecommerce, automation and integrations.</p>
      </article>
      <article class="process-card" data-process-card>
        <span class="process-card__num">05</span>
        <h3>Scale</h3>
        <p>Launch, learn and keep improving as the business moves forward.</p>
      </article>
    </div>

    <div class="process__dots" id="processDots" aria-hidden="true">
      <i class="is-active"></i><i></i><i></i><i></i><i></i>
    </div>
  </div>
</section>
