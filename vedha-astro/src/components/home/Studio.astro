---
const cards = [
  {
    title: "Commercial thinking from day one",
    icon: "thinking",
  },
  {
    title: "Built around your way forward",
    icon: "path",
  },
  {
    title: "Clear scope, clear decisions",
    icon: "scope",
  },
  {
    title: "Support that stays close",
    icon: "support",
  },
] as const;
---

<!-- ===== Studio / Who we are ===== -->
<section class="studio" id="studio">
  <p class="kicker" data-reveal>(Who we are)&ensp;[VEDHA — Dubai]</p>

  <figure class="scene-banner" data-scene-banner>
    <picture>
      <img
        src="/images/photo-dubai-marina.jpg"
        alt="Dubai skyline — Vedha’s home base for custom software development"
        width="1600"
        height="1067"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <h2 class="scene-banner__title">
      <span class="scene-banner__line">Strategy, design</span>
      <span class="scene-banner__line">and senior engineering</span>
      <span class="scene-banner__line">in one focused team.</span>
    </h2>
    <figcaption class="scene-banner__meta">
      <span>Dubai</span>
      <span>Built for the UAE · Ready for the GCC</span>
    </figcaption>
  </figure>

  <p class="section-lead" data-reveal>
    Vedha Technologies is a software development company in Dubai that brings strategy, design and senior engineering into one focused team. We help UAE and GCC businesses build systems that drive revenue, buy back time and scale operations without scaling headcount.
  </p>

  <div class="studio__cards">
    {cards.map((card) => (
      <article class="s-card s-card--icon" data-reveal>
        <span class="s-card__icon" aria-hidden="true">
          {card.icon === "thinking" && (
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <circle cx="9" cy="14" r="3.25" stroke="currentColor" stroke-width="1.5" />
              <circle cx="14" cy="14" r="3.25" stroke="currentColor" stroke-width="1.5" />
              <circle cx="19" cy="14" r="3.25" stroke="currentColor" stroke-width="1.5" />
            </svg>
          )}
          {card.icon === "path" && (
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <circle cx="14" cy="14" r="9" stroke="currentColor" stroke-width="1.5" />
              <path d="M14 8.5v5.2l3.2 1.9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
          {card.icon === "scope" && (
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <path d="M9.5 8.5h9.2a1.8 1.8 0 0 1 1.8 1.8v2.1l-2.1 1.1-4.3 7.4a.9.9 0 0 1-1.55 0l-4.3-7.4-2.1-1.1V10.3a1.8 1.8 0 0 1 1.8-1.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
              <path d="M9.2 12.2h9.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          )}
          {card.icon === "support" && (
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <path d="M8.5 11.5c0-3.2 2.5-5.8 5.5-5.8s5.5 2.6 5.5 5.8v3.2c0 .9-.4 1.7-1.1 2.2l-1.6 1.1v1.7a1.4 1.4 0 0 1-1.4 1.4h-1.8a1.4 1.4 0 0 1-1.4-1.4v-1.7l-1.6-1.1a2.7 2.7 0 0 1-1.1-2.2v-3.2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
              <path d="M11.2 21.8h5.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          )}
        </span>
        <h3 class="s-card__title">{card.title}</h3>
      </article>
    ))}
  </div>
</section>
