<!-- ===== Studio / Who we are ===== -->
<section class="studio" id="studio">
  <p class="kicker" data-reveal>(Who we are)&ensp;[VEDHA — Dubai]</p>

  <figure class="scene-banner" data-scene-banner>
    <picture>
      <img
        src="/images/photo-dubai-marina.jpg"
        alt="Dubai skyline — Vedha’s home base for custom software development"
        width="1600"
        height="1067"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <h2 class="scene-banner__title">
      <span class="scene-banner__line">Strategy, design</span>
      <span class="scene-banner__line">and senior engineering</span>
      <span class="scene-banner__line">in one focused team.</span>
    </h2>
    <figcaption class="scene-banner__meta">
      <span>Dubai</span>
      <span>Built for the UAE · Ready for the GCC</span>
    </figcaption>
  </figure>

  <p class="section-lead" data-reveal>
    Vedha Technologies is a software development company in Dubai that brings strategy, design and senior engineering into one focused team. We help UAE and GCC businesses build systems that drive revenue, buy back time and scale operations without scaling headcount.
  </p>

  <div class="studio__cards">
    <article class="s-card" data-reveal>
      <p class="kicker">(Commercial edge)</p>
      <div class="avatars" aria-hidden="true">
        <img src="/images/photo-moraine-lake.jpg" alt="" width="96" height="96" loading="lazy" decoding="async" />
        <img src="/images/photo-waterfall.jpg" alt="" width="96" height="96" loading="lazy" decoding="async" />
        <img src="/images/photo-cliff-coast.jpg" alt="" width="96" height="96" loading="lazy" decoding="async" />
        <span>+1</span>
      </div>
      <p class="s-card__big">
        Commercial thinking from day one
        <small>Strategy and engineering aligned to how you grow</small>
      </p>
    </article>

    <article class="s-card s-card--dark" data-reveal>
      <p class="kicker">(Your way forward)</p>
      <p class="s-card__big">Built around your way forward</p>
      <p class="s-card__note">
        Systems shaped around how you serve customers, manage teams and make decisions — not generic templates.
      </p>
    </article>

    <article class="s-card s-card--photo s-card--estimator" data-reveal>
      <picture class="s-card__media">
        <img
          class="s-card__bg"
          src="/images/photo-dubai-aerial.jpg"
          alt=""
          width="1600"
          height="1067"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
      </picture>

      <div class="s-card__estimator" aria-hidden="true">
        <p class="s-card__estimator-kicker">Live AED estimate</p>
        <p class="s-card__estimator-total">AED 28,500</p>
        <ul class="s-card__estimator-chips">
          <li>Corporate site</li>
          <li>CMS</li>
          <li>SEO</li>
        </ul>
      </div>

      <p class="s-card__big">Clear scope, clear decisions</p>
      <a class="btn btn--light" href="/cost-estimator/"><span>Calculate cost</span></a>
    </article>

    <article class="s-card s-card--chat" data-reveal>
      <p class="kicker">(Support that stays close)</p>
      <p class="chat__time">Today 17:01</p>
      <p class="chat__bubble">Can we review the sprint goals?</p>
      <p class="chat__bubble">Need the timeline by Friday</p>
      <p class="chat__time">Today 17:02</p>
      <p class="chat__bubble chat__bubble--me">Shared — milestones locked in</p>
      <p class="chat__bubble">Perfect, thanks Vedha.</p>
    </article>
  </div>
</section>
