---
interface Props {
  name?: string;
  value?: string;
  label?: string;
}
const { name = "image", value = "", label = "Image" } = Astro.props;
const inputId = `${name}Input`;
const previewId = `${name}Preview`;
---

<label>
  {label}
  <div class="upload-row">
    <input type="text" name={name} id={inputId} value={value} placeholder="/images/photo-dubai-marina.jpg" />
    <button type="button" class="btn btn--ghost" data-upload-target={inputId} data-upload-preview={previewId}>Upload…</button>
  </div>
  <img id={previewId} class="cover-preview" src={value} alt="" style={value ? "" : "display:none"} />
</label>

<style>
  .upload-row { display: flex; gap: 0.6rem; }
  .upload-row input { flex: 1; }
  .cover-preview {
    margin-top: 0.6rem;
    width: 100%;
    max-height: 160px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: #111;
  }
</style>
