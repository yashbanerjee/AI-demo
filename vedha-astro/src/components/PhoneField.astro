---
interface Props {
  id?: string;
  name?: string;
  required?: boolean;
  placeholder?: string;
}

const {
  id = "phone",
  name = "phone",
  required = false,
  placeholder = "50 000 0000",
} = Astro.props;

const countries = [
  { code: "AE", dial: "+971" },
  { code: "SA", dial: "+966" },
  { code: "QA", dial: "+974" },
  { code: "KW", dial: "+965" },
  { code: "BH", dial: "+973" },
  { code: "OM", dial: "+968" },
  { code: "IN", dial: "+91" },
  { code: "PK", dial: "+92" },
  { code: "BD", dial: "+880" },
  { code: "PH", dial: "+63" },
  { code: "EG", dial: "+20" },
  { code: "GB", dial: "+44" },
  { code: "US", dial: "+1" },
  { code: "CA", dial: "+1" },
];
---

<div class="phone-field" data-phone-field>
  <label class="visually-hidden" for={`${id}-code`}>Country code</label>
  <select
    id={`${id}-code`}
    class="phone-field__code"
    data-phone-code
    autocomplete="tel-country-code"
    aria-label="Country calling code"
  >
    {countries.map((c) =>
      c.code === "AE" ? (
        <option value={c.dial} selected>
          {c.code} {c.dial}
        </option>
      ) : (
        <option value={c.dial}>
          {c.code} {c.dial}
        </option>
      )
    )}
  </select>
  <input
    id={id}
    class="phone-field__number"
    type="tel"
    inputmode="numeric"
    autocomplete="tel-national"
    data-phone-number
    placeholder={placeholder}
    required={required}
    aria-label="Mobile number"
  />
  <input type="hidden" name={name} value="" data-phone-full />
</div>
