# Postgres connection string. Locally this points at the embedded Postgres
# started by `npm run db:start`; in production use your managed Postgres URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/vedha

# Password for the /admin panel login.
ADMIN_PASSWORD=change-me

# Random secret used to sign admin session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me

# Email — form submissions go to CONTACT_TO (default info@vedha.ae).
#
# Railway Hobby/Free blocks outbound SMTP (ports 25/465/587). Use Resend over HTTPS:
#   1. Create a free key at https://resend.com
#   2. Set RESEND_API_KEY on Railway
#   3. Set SMTP_FROM to a verified sender, e.g. Vedha <noreply@vedha.ae>
#      (or leave default onboarding@resend.dev for testing)
RESEND_API_KEY=
#
# SMTP only works outside Railway, or on Railway Pro with ALLOW_SMTP=true.
ALLOW_SMTP=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vedha Website <noreply@vedha.ae>
CONTACT_TO=info@vedha.ae
SMTP_TLS_REJECT_UNAUTHORIZED=true
