# Email — form submissions go to CONTACT_TO (default info@vedha.ae).
#
# SMTP (works on Railway Pro — redeploy after upgrading if you just moved to Pro):
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vedha Website <noreply@vedha.ae>
CONTACT_TO=info@vedha.ae
# Set to false only if your SMTP host uses a self-signed / mismatched cert.
SMTP_TLS_REJECT_UNAUTHORIZED=true
#
# Optional HTTPS alternative (Resend). If set, it is used instead of SMTP.
# RESEND_API_KEY=
